+  unsigned long long pdsim_opcount[PDSIM_MAXOPS];  /* executed opcodes */
+  unsigned long long pdsim_native_opcount[PDSIM_MAXOPS];  /* ... in "=[pdsim]" chunks */
+  unsigned long long pdsim_alloced;  /* bytes allocated */
+  unsigned long long pdsim_freed;  /* bytes freed */
+  unsigned long long pdsim_gcwork;  /* units of collector work */
+  unsigned long long pdsim_ccalls;  /* C functions called by game code */
